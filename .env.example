# All optional — defaults shown.
PORT=8080
TZ=Europe/Lisbon
TEMP_WARN_C=70
TEMP_DANGER_C=80
POLL_MS=3000
CHECK_INTERVAL_S=15
HISTORY_INTERVAL_S=300
RETENTION_DAYS=183
WIFI_IFACE=wlan0
WIFI_WEAK_DBM=-75
HOST_PROC=/host/proc
HOST_SYS=/sys
THERMAL_ZONE=auto
DISK_PATH=/data
DATA_DIR=/data
CONFIG_FILE=/config/vault.json
# Outside temperature (Open-Meteo). Leave unset to disable.
LATITUDE=
LONGITUDE=
